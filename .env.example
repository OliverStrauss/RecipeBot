# Copy this file to .env and fill it in. Never commit .env.
# Set either CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY, never both,
# depending on CLAUDE_BACKEND.

DISCORD_TOKEN=

# Claude backend: claude_cli (subscription, default) or api (API key)
CLAUDE_BACKEND=claude_cli
# Optional. Blank = the CLI's default model. For api, e.g. claude-sonnet-5-5
CLAUDE_MODEL=

# claude_cli backend
# From `claude setup-token`. Do NOT also set ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_TIMEOUT_SECONDS=180

# api backend (only when CLAUDE_BACKEND=api)
ANTHROPIC_API_KEY=

WHISPER_MODEL=base
# Optional: Netscape-format cookies from a throwaway Instagram account
IG_COOKIES_PATH=
DB_PATH=./data/recipes.db
TEMP_DIR=./data/tmp
MAX_VIDEO_SECONDS=600
MAX_FRAMES=20
FRAME_INTERVAL_SECONDS=2
DEFAULT_DAILY_LIMIT=15
WORKER_CONCURRENCY=1
# Optional: sync slash commands instantly to one test server (right-click server > Copy Server ID)
DEV_GUILD_ID=
LOG_LEVEL=INFO
